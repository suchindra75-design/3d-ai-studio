{
  "name": "ai-3d-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first image-to-3D reconstruction platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:backend": "uv run ai3d-server --reload",
    "dev:web": "pnpm --filter @ai3d/web dev",
    "dev:desktop": "pnpm --filter @ai3d/desktop tauri dev",
    "build": "pnpm --filter @ai3d/web build && pnpm --filter @ai3d/desktop build",
    "bundle:engine": "uv run --no-project --python 3.11 python infrastructure/scripts/bundle_engine.py",
    "build:desktop-app": "pnpm bundle:engine && pnpm --filter @ai3d/desktop tauri build --config src-tauri/tauri.bundle-engine.conf.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p . && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test -c playwright.desktop.config.ts",
    "test:e2e:workflows": "playwright test -c playwright.workflows.config.ts",
    "gen:api": "node infrastructure/scripts/gen-api-types.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
