# AI 3D Studio — environment configuration (copy to .env; .env is git-ignored).
# Every backend setting uses the AI3D_ prefix. Defaults are shown commented out.

# --- Storage -----------------------------------------------------------------
# Where projects, uploads, models and the SQLite database live. Relative paths
# resolve against the directory the backend is started from (the repo root for
# `pnpm dev:backend`). Default: the OS user-data folder, e.g.
#   macOS   ~/Library/Application Support/AI3DStudio
#   Linux   ~/.local/share/AI3DStudio
#   Windows %LOCALAPPDATA%\AI3DStudio
AI3D_DATA_DIR=.data

# Use PostgreSQL instead of SQLite (requires: uv sync --extra postgres)
# AI3D_DATABASE_URL=postgresql+psycopg://ai3d:ai3d@localhost:5432/ai3d
# AI3D_AUTO_MIGRATE=true

# --- Server ------------------------------------------------------------------
# AI3D_HOST=127.0.0.1          # keep 127.0.0.1 unless you know you need LAN access
# AI3D_PORT=8000
# AI3D_ENVIRONMENT=development # development | production | test
# AI3D_LOG_LEVEL=INFO
# AI3D_LOG_FORMAT=console      # console | json
# AI3D_EXPOSE_PATHS=true       # show the data folder path in Settings
# AI3D_CORS_ORIGINS=["http://localhost:3000","http://localhost:1420","tauri://localhost","http://tauri.localhost"]
# Host names the API answers to (DNS-rebinding protection). Add your server's
# name when you expose it, e.g. ["127.0.0.1","localhost","studio.example.org"].
# AI3D_ALLOWED_HOSTS=["127.0.0.1","localhost","::1","[::1]"]

# --- Uploads -----------------------------------------------------------------
# AI3D_MAX_UPLOAD_BYTES=52428800       # 50 MB per photo
# AI3D_MAX_IMAGES_PER_PROJECT=300
# AI3D_MAX_IMAGE_PIXELS=150000000      # decompression-bomb guard
# AI3D_THUMBNAIL_SIZE=512

# --- Web app (Next.js) -------------------------------------------------------
# Backend origin that the web app proxies /api/v1 to (read at build/start time).
# AI3D_API_URL=http://127.0.0.1:8000

# --- Desktop app --------------------------------------------------------------
# The desktop app starts its own private engine and sets these itself; set them
# only to run the desktop UI in a plain browser against a backend you started.
# VITE_AI3D_API_URL=http://127.0.0.1:8000
# VITE_AI3D_API_TOKEN=
# Use a specific ai3d-server executable instead of the bundled/repository one.
# AI3D_DESKTOP_BACKEND=/path/to/ai3d-server

# --- Access token ----------------------------------------------------------------
# When set (16+ characters), every /api/* call except /api/v1/health needs
# "Authorization: Bearer <token>" or ?access_token=<token>. The desktop app sets
# a random one per launch. Leave unset for the web app and Docker.
# AI3D_API_TOKEN=
# Exit when this process id disappears (the desktop app sets it).
# AI3D_PARENT_PID=

# --- AI providers ------------------------------------------------------------
# Keys are read by the backend only; they are never sent to the browser.
# Both providers are paid services; see docs/AI_PROVIDERS.md for costs.
# Keys set here take precedence over keys entered in Settings.
# AI3D_TRIPO_API_KEY=
# AI3D_MESHY_API_KEY=
# Encrypts keys entered in Settings (16+ random characters). If unset, a random
# key is created in <data dir>/secret.key; keep that file private.
# AI3D_SECRET_KEY=

# --- Jobs ----------------------------------------------------------------------
# AI3D_RUN_JOBS=true                 # run generation jobs inside the backend process
# AI3D_MAX_CONCURRENT_JOBS=2
# AI3D_PROVIDER_POLL_INTERVAL=3      # seconds between provider status checks
# AI3D_JOB_TIMEOUT_SECONDS=3600
# AI3D_MAX_MODEL_BYTES=524288000     # largest accepted 3D result (500 MB)
# AI3D_PROVIDER_IMAGE_MAX_SIDE=2048  # longest side of photo copies sent to providers

# --- Storage backend ---------------------------------------------------------------
# Keep photos, models and exports in an S3-compatible bucket instead of the data
# folder (needs: uv sync --extra s3). The database is configured separately.
# AI3D_STORAGE_BACKEND=s3
# AI3D_S3_BUCKET=ai3d
# AI3D_S3_PREFIX=studio
# AI3D_S3_ENDPOINT_URL=https://s3.example.org   # omit for AWS
# AI3D_S3_REGION=eu-central-1
# Optional; otherwise the standard AWS credential chain is used.
# AI3D_S3_ACCESS_KEY_ID=
# AI3D_S3_SECRET_ACCESS_KEY=

# --- Docker Compose only --------------------------------------------------------------
# Compose also reads AI3D_DATABASE_URL from this file, so remove it (or leave it
# empty) unless the containers should use that database.
# AI3D_POSTGRES_PASSWORD=          # required with --profile postgres
# AI3D_BACKEND_TARGET=backend-colmap  # backend image with COLMAP 4 (CPU)

# --- Error reporting (optional, off by default) -------------------------------------
# Report unexpected errors (scrubbed, no request data) to a Sentry-compatible
# service you choose. Needs: uv sync --extra errors. See docs/ERROR_REPORTING.md.
# AI3D_SENTRY_DSN=

# --- Local AI engine (TripoSR) -----------------------------------------------------
# Installed with `uv run ai3d-local-ai install` (docs/LOCAL_GPU_SETUP.md).
# AI3D_LOCAL_AI_DIR=~/.local/share/ai3d-studio/tools/local-ai
# AI3D_LOCAL_AI_TIMEOUT_SECONDS=1800

# --- Local photogrammetry ---------------------------------------------------------
# COLMAP is found on PATH; set this when it is installed elsewhere.
# AI3D_COLMAP_PATH=/path/to/colmap
# AI3D_RECONSTRUCTION_TIMEOUT_SECONDS=14400
# OpenMVS (dense surfaces on the CPU); found in the usual places unless set.
# AI3D_OPENMVS_DIR=~/.local/share/ai3d-studio/tools/openmvs/bin
